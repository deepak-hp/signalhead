{
  "name": "signalhead",
  "version": "1.1.3",
  "description": "A traffic light for your AI coding agents. Red when Claude Code, Codex or Gemini needs you, yellow while it works, green when it's done. A floating always-on-top overlay for macOS, Windows and Linux.",
  "bin": {
    "signalhead": "src/cli.js",
    "sig": "src/cli.js"
  },
  "main": "src/overlay/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/cli.js start",
    "overlay": "electron src/overlay/main.js",
    "server": "node src/cli.js server",
    "setup": "node scripts/setup.js",
    "status": "node src/cli.js status",
    "test": "node --test",
    "doctor": "node src/cli.js doctor",
    "watch:codex": "node src/cli.js watch codex",
    "test:linux": "bash scripts/run-linux-tests.sh",
    "test:ui": "playwright test",
    "test:all": "npm test && npm run test:ui"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "optionalDependencies": {
    "electron": "^38.0.0",
    "node-pty": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepak-hp/signalhead.git"
  },
  "homepage": "https://deepak-hp.github.io/signalhead",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agent",
    "overlay",
    "traffic-light",
    "status",
    "always-on-top",
    "gemini-cli",
    "aider",
    "developer-tools",
    "cli"
  ],
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "bugs": {
    "url": "https://github.com/deepak-hp/signalhead/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
